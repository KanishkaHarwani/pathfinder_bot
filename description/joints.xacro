<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- =========================================== -->
    <!-- ============= CHASSIS JOINT =============== -->
    <!-- =========================================== -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="-0.1 0 -0.025" rpy="0 0 0"/>
    </joint>

    <!-- =========================================== -->
    <!-- ============ LEFT WHEEL JOINT ============= -->
    <!-- =========================================== -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.175 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- effort (N*m) replaces the old <max_wheel_torque> from the
             Classic diff_drive plugin; velocity (rad/s) is a reasonable
             default, tune to your motors -->
        <limit effort="200" velocity="10.0"/>
    </joint>

    <!-- =========================================== -->
    <!-- ========== RIGHT WHEEL JOINT ============== -->
    <!-- =========================================== -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.175 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="200" velocity="10.0"/>
    </joint>

    <!-- =========================================== -->
    <!-- ======== FRONT CASTER WHEEL JOINT ========= -->
    <!-- =========================================== -->
    <joint name="front_caster_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="0.4 0 0" rpy="0 0 0"/>
    </joint>

    <!-- =========================================== -->
    <!-- ============== CAMERA JOINT =============== -->
    <!-- =========================================== -->
    <joint name="front_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_camera_link"/>
        <origin xyz="0.35 0 0.2" rpy="0 0 0"/>
    </joint>
    <joint name="rear_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_camera_link"/>
        <origin xyz="-0.05 0 0.2" rpy="0 0 ${pi}"/>
    </joint>

    <!-- =========================================== -->
    <!-- ========== CAMERA OPTICAL JOINT =========== -->
    <!-- =========================================== -->
    <joint name="front_camera_optical_joint" type="fixed">
        <parent link="front_camera_link"/>
        <child link="front_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <joint name="rear_camera_optical_joint" type="fixed">
        <parent link="rear_camera_link"/>
        <child link="rear_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- =========================================== -->
    <!-- ============== LiDAR JOINT ================ -->
    <!-- =========================================== -->
    <joint name="lidar_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_base_link"/>
        <origin xyz="0.25 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- =========================================== -->
    <!-- ============== LiDAR JOINT ================ -->
    <!-- =========================================== -->
    <joint name="lidar_joint" type="fixed">
        <parent link="lidar_base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

</robot>
